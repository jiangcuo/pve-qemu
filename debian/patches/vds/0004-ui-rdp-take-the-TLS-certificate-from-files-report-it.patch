From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jiangcuo <jiangcuo@bingsin.com>
Date: Sun, 8 Nov 2026 16:53:21 +0800
Subject: [PATCH 4/6] ui/rdp: take the TLS certificate from files, report its
 fingerprint

Add x509-cert-file and x509-key-file to -rdp: PEM files of the server
certificate and its key, instead of a tls-creds-x509 object, whose
directory needs fixed file names. With neither, libvds generates a
self-signed certificate on first use and keeps it until QEMU exits.

Add the SHA-256 fingerprint of the RDP server certificate to query-rdp
and "info rdp", from vds_server_tls_fingerprint(), so management
software can pass it to clients for pinning.

Signed-off-by: jiangcuo <jiangcuo@bingsin.com>
---
 qapi/ui.json    |  7 +++++
 qemu-options.hx |  9 ++++--
 ui/rdp-core.c   | 76 +++++++++++++++++++++++++++++++++++++++----------
 3 files changed, 75 insertions(+), 17 deletions(-)

diff --git a/qapi/ui.json b/qapi/ui.json
index 0d0df98c38..a0b237d8cc 100644
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -227,6 +227,11 @@
 #
 # @auth: authentication method ("none", "tls" or "nla")
 #
+# @fingerprint: SHA-256 fingerprint of the server TLS certificate, as
+#     uppercase hex bytes separated by colons.  Without @tls-creds a
+#     self-signed certificate is generated on first use and kept until
+#     QEMU exits.
+#
 # @clients: connected clients
 #
 # @debug-dir: directory collecting the per-session diagnostic files, if
@@ -245,6 +250,7 @@
             '*host': 'str',
             '*port': 'int',
             '*auth': 'str',
+            '*fingerprint': 'str',
             'clients': ['RdpClientInfo'],
             '*debug-dir': 'str',
             '*debug-input': 'bool',
@@ -263,6 +269,7 @@
 #     -> { "execute": "query-rdp" }
 #     <- { "return": { "enabled": true, "host": "127.0.0.1",
 #                      "port": 3389, "auth": "nla",
+#                      "fingerprint": "3A:5F:...:C2",
 #                      "clients": [ { "sid": 1,
 #                                     "peer": "127.0.0.1:52000",
 #                                     "user": "vdi", "codec": "avc420",
diff --git a/qemu-options.hx b/qemu-options.hx
index fbec5998f4..abb0530059 100644
--- a/qemu-options.hx
+++ b/qemu-options.hx
@@ -2266,6 +2266,7 @@ ERST
 #ifdef CONFIG_RDP
 DEF("rdp", HAS_ARG, QEMU_OPTION_rdp,
     "-rdp [addr=addr][,port=port][,tls-creds=<id>][,auth=none|tls|nla]\n"
+    "       [,x509-cert-file=<file>,x509-key-file=<file>]\n"
     "       [,username=<name>][,password-secret=<secret-id>]\n"
     "       [,codecs=avc420:remotefx:bitmap][,max-fps=<n>][,bitrate=<kbps>]\n"
     "       [,encoder=openh264|vaapi][,rendernode=<path>]\n"
@@ -2295,8 +2296,12 @@ SRST
 
     ``tls-creds=<id>``
         ID of a ``tls-creds-x509`` object (``endpoint=server``) providing
-        ``server-cert.pem`` and ``server-key.pem``. Without it, a
-        self-signed certificate is generated at start.
+        ``server-cert.pem`` and ``server-key.pem``. Without it or
+        ``x509-cert-file``, a self-signed certificate is generated at start.
+
+    ``x509-cert-file=<file>``; \ ``x509-key-file=<file>``
+        PEM files of the server certificate (chain) and its private key,
+        instead of ``tls-creds``. Both are needed.
 
     ``auth=none|tls|nla``
         Authentication method. ``nla`` (default) uses TLS and CredSSP;
diff --git a/ui/rdp-core.c b/ui/rdp-core.c
index a58ed11f8c..36e2bdb28c 100644
--- a/ui/rdp-core.c
+++ b/ui/rdp-core.c
@@ -54,6 +54,8 @@ static QemuOptsList qemu_rdp_opts = {
         { .name = "addr", .type = QEMU_OPT_STRING },
         { .name = "port", .type = QEMU_OPT_NUMBER },
         { .name = "tls-creds", .type = QEMU_OPT_STRING },
+        { .name = "x509-cert-file", .type = QEMU_OPT_STRING },
+        { .name = "x509-key-file", .type = QEMU_OPT_STRING },
         { .name = "auth", .type = QEMU_OPT_STRING },
         { .name = "username", .type = QEMU_OPT_STRING },
         { .name = "password-secret", .type = QEMU_OPT_STRING },
@@ -329,6 +331,27 @@ static uint32_t rdp_debug_flags(QemuOpts *opts)
     return flags;
 }
 
+static bool rdp_load_tls_files(const char *cert_path, const char *key_path,
+                               Error **errp)
+{
+    g_autofree char *cert = NULL;
+    g_autofree char *key = NULL;
+    g_autoptr(GError) gerr = NULL;
+    char *vds_err = NULL;
+
+    if (!g_file_get_contents(cert_path, &cert, NULL, &gerr) ||
+        !g_file_get_contents(key_path, &key, NULL, &gerr)) {
+        error_setg(errp, "rdp: cannot read TLS credentials: %s",
+                   gerr->message);
+        return false;
+    }
+    if (vds_server_set_tls(rdp.server, cert, key, &vds_err) != VDS_OK) {
+        rdp_error_take(errp, vds_err, "invalid TLS credentials");
+        return false;
+    }
+    return true;
+}
+
 static bool rdp_load_tls_creds(const char *id, Error **errp)
 {
     Object *obj;
@@ -336,10 +359,6 @@ static bool rdp_load_tls_creds(const char *id, Error **errp)
     g_autofree char *dir = NULL;
     g_autofree char *cert_path = NULL;
     g_autofree char *key_path = NULL;
-    g_autofree char *cert = NULL;
-    g_autofree char *key = NULL;
-    g_autoptr(GError) gerr = NULL;
-    char *vds_err = NULL;
 
     obj = object_resolve_path_component(object_get_objects_root(), id);
     if (!obj || !object_dynamic_cast(obj, TYPE_QCRYPTO_TLS_CREDS_X509)) {
@@ -358,17 +377,7 @@ static bool rdp_load_tls_creds(const char *id, Error **errp)
     }
     cert_path = g_build_filename(dir, QCRYPTO_TLS_CREDS_X509_SERVER_CERT, NULL);
     key_path = g_build_filename(dir, QCRYPTO_TLS_CREDS_X509_SERVER_KEY, NULL);
-    if (!g_file_get_contents(cert_path, &cert, NULL, &gerr) ||
-        !g_file_get_contents(key_path, &key, NULL, &gerr)) {
-        error_setg(errp, "rdp: cannot read TLS credentials: %s",
-                   gerr->message);
-        return false;
-    }
-    if (vds_server_set_tls(rdp.server, cert, key, &vds_err) != VDS_OK) {
-        rdp_error_take(errp, vds_err, "invalid TLS credentials");
-        return false;
-    }
-    return true;
+    return rdp_load_tls_files(cert_path, key_path, errp);
 }
 
 static void rdp_exit_notify(Notifier *n, void *data)
@@ -394,6 +403,8 @@ void qemu_rdp_init(Error **errp)
     VdsConfig cfg;
     VdsLogConfig log_cfg = { .struct_size = sizeof(VdsLogConfig) };
     const char *str;
+    const char *cert_file;
+    const char *key_file;
     char *vds_err = NULL;
     uint32_t version = vds_abi_version();
     uint64_t port;
@@ -468,9 +479,22 @@ void qemu_rdp_init(Error **errp)
     }
 
     str = qemu_opt_get(opts, "tls-creds");
+    cert_file = qemu_opt_get(opts, "x509-cert-file");
+    key_file = qemu_opt_get(opts, "x509-key-file");
+    if (!cert_file != !key_file) {
+        error_setg(errp, "rdp: x509-cert-file and x509-key-file go together");
+        return;
+    }
+    if (str && cert_file) {
+        error_setg(errp, "rdp: tls-creds and x509-cert-file exclude each other");
+        return;
+    }
     if (str && !rdp_load_tls_creds(str, errp)) {
         return;
     }
+    if (cert_file && !rdp_load_tls_files(cert_file, key_file, errp)) {
+        return;
+    }
 
     rdp.username = g_strdup(qemu_opt_get(opts, "username") ?: "");
     str = qemu_opt_get(opts, "password-secret");
@@ -628,6 +652,24 @@ static RdpClientInfoList *rdp_client_list(void)
     return list;
 }
 
+/* Returns a g_malloc'ed copy of the certificate fingerprint, or NULL. */
+static char *rdp_tls_fingerprint(void)
+{
+    char *vds_err = NULL;
+    char *fp = vds_server_tls_fingerprint(rdp.server, &vds_err);
+    char *ret;
+
+    if (!fp) {
+        warn_report("rdp: cannot get the TLS fingerprint: %s",
+                    vds_err ? vds_err : "unknown error");
+        vds_free_string(vds_err);
+        return NULL;
+    }
+    ret = g_strdup(fp);
+    vds_free_string(fp);
+    return ret;
+}
+
 RdpInfo *qmp_query_rdp(Error **errp)
 {
     RdpInfo *info = g_new0(RdpInfo, 1);
@@ -642,6 +684,7 @@ RdpInfo *qmp_query_rdp(Error **errp)
         info->port = rdp.port;
     }
     info->auth = g_strdup(rdp.auth);
+    info->fingerprint = rdp_tls_fingerprint();
     info->clients = rdp_client_list();
     if (rdp.debug_dir) {
         /* A string member has no has_ companion: NULL means "absent". */
@@ -669,6 +712,9 @@ void hmp_info_rdp(Monitor *mon, const QDict *qdict)
     } else {
         monitor_printf(mon, "Server: not listening (auth %s)\n", info->auth);
     }
+    if (info->fingerprint) {
+        monitor_printf(mon, "Fingerprint: %s\n", info->fingerprint);
+    }
     if (rdp.debug_dir) {
         monitor_printf(mon, "Debug: %s (input=%s video=%s)\n", rdp.debug_dir,
                        rdp.debug_flags & VDS_DEBUG_INPUT ? "on" : "off",
