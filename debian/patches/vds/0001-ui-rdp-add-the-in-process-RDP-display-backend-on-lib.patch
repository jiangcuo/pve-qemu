+  'if': 'CONFIG_RDP' }
+
+##
+# @RDP_CONNECTED:
+#
+# Emitted when an RDP client opens a connection, before
+# authentication.
+#
+# @client: the client
+#
+# Since: 10.0
+##
+{ 'event': 'RDP_CONNECTED',
+  'data': { 'client': 'RdpEventClient' },
+  'if': 'CONFIG_RDP' }
+
+##
+# @RDP_INITIALIZED:
+#
+# Emitted when an RDP client is authenticated and its session is set
+# up.
+#
+# @client: the client
+#
+# Since: 10.0
+##
+{ 'event': 'RDP_INITIALIZED',
+  'data': { 'client': 'RdpEventClient' },
+  'if': 'CONFIG_RDP' }
+
+##
+# @RDP_DISCONNECTED:
+#
+# Emitted when an RDP connection is closed.
+#
+# @client: the client
+#
+# @reason: why the connection ended
+#
+# Since: 10.0
+##
+{ 'event': 'RDP_DISCONNECTED',
+  'data': { 'client': 'RdpEventClient', 'reason': 'str' },
+  'if': 'CONFIG_RDP' }
+
+##
+# @rdp-set-debug:
+#
+# Enable or disable the optional RDP debug traces at runtime.  The
+# files written for every connection (session.log, client.json,
+# frames.csv, pointer.csv, audio.csv) follow the debug directory given
+# to -rdp debug-dir; this command only turns the optional ones on and
+# off.
+#
+# @input: record client keyboard and mouse events in input.csv.
+#     Keys that type text are recorded as "char" without their
+#     scancode.
+#
+# @video: record the encoded Annex-B video stream in video-headN.h264.
+#
+# @pdu: record the decrypted client PDUs in client-pdus.bin (reserved,
+#     not implemented yet).
+#
+# Errors:
+#     - If -rdp debug-dir was not given.
+#
+# Since: 10.0
+#
+# .. qmp-example::
+#
+#     -> { "execute": "rdp-set-debug",
+#          "arguments": { "input": true } }
+#     <- { "return": {} }
+##
+{ 'command': 'rdp-set-debug',
+  'data': { '*input': 'bool', '*video': 'bool', '*pdu': 'bool' },
+  'if': 'CONFIG_RDP' }
+
 ##
