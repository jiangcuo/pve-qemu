--- a/ui/trace-events
+++ b/ui/trace-events
@@ -210,3 +210,25 @@ dbus_can_share_map(bool share) "can_share_map: %d"
 
 # egl-helpers.c
 egl_init_d3d11_device(void *p) "d3d device: %p"
