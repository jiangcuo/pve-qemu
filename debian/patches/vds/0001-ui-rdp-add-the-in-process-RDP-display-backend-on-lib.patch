+/* Option parsing */
+
+static bool rdp_parse_codecs(const char *list, uint32_t *bits, Error **errp)
+{
+    g_auto(GStrv) names = g_strsplit(list, ":", -1);
+    int i;
+
+    *bits = 0;
+    for (i = 0; names[i]; i++) {
+        if (!strcmp(names[i], "avc420")) {
+            *bits |= VDS_CODEC_AVC420;
+        } else if (!strcmp(names[i], "remotefx")) {
+            *bits |= VDS_CODEC_REMOTEFX;
+        } else if (!strcmp(names[i], "bitmap")) {
+            *bits |= VDS_CODEC_BITMAP;
+        } else if (names[i][0]) {
+            error_setg(errp, "rdp: unknown codec '%s'", names[i]);
+            return false;
+        }
+    }
+    if (!*bits) {
+        error_setg(errp, "rdp: no codec allowed");
+        return false;
+    }
+    return true;
+}
+
+static bool rdp_parse_auth(const char *auth, uint32_t *mode, Error **errp)
+{
+    if (!auth || !strcmp(auth, "nla")) {
+        *mode = VDS_AUTH_NLA;
+        rdp.auth = "nla";
+    } else if (!strcmp(auth, "tls")) {
+        *mode = VDS_AUTH_TLS;
+        rdp.auth = "tls";
+    } else if (!strcmp(auth, "none")) {
+        *mode = VDS_AUTH_NONE;
+        rdp.auth = "none";
+    } else {
+        error_setg(errp, "rdp: auth must be 'none', 'tls' or 'nla'");
+        return false;
+    }
+    return true;
+}
+
+/*
+ * Resolves sas-hotkey: what the client's Ctrl+Alt+End turns into for the
+ * guest. Clients cannot send Ctrl+Alt+Del themselves, so they send
+ * Ctrl+Alt+End and expect the server to inject the secure attention
+ * sequence -- mstsc's behaviour, and the default here.
+ */
+static bool rdp_parse_sas(const char *sas, uint32_t *mode, Error **errp)
+{
+    if (!sas || !strcmp(sas, "ctrl-alt-end")) {
+        *mode = VDS_SAS_CTRL_ALT_END;
+    } else if (!strcmp(sas, "off")) {
+        *mode = VDS_SAS_OFF;
+    } else {
+        error_setg(errp, "rdp: sas-hotkey must be 'ctrl-alt-end' or 'off'");
+        return false;
+    }
+    return true;
+}
+
+/*
+ * Resolves debug-dir: "on" (and the usual boolean spellings) means the
+ * platform's temporary directory, %TEMP%\vds or /tmp/vds.
+ */
+static char *rdp_debug_dir(const char *value)
+{
+    if (!value) {
+        return NULL;
+    }
+    if (!strcmp(value, "on") || !strcmp(value, "yes") ||
+        !strcmp(value, "true")) {
+        return g_build_filename(g_get_tmp_dir(), "vds", NULL);
+    }
+    return g_strdup(value);
+}
+
+static uint32_t rdp_debug_flags(QemuOpts *opts)
+{
+    uint32_t flags = 0;
+
+    if (qemu_opt_get_bool(opts, "debug-input", false)) {
+        flags |= VDS_DEBUG_INPUT;
+    }
+    if (qemu_opt_get_bool(opts, "debug-video", false)) {
+        flags |= VDS_DEBUG_VIDEO;
+    }
+    return flags;
+}
+
+static bool rdp_load_tls_creds(const char *id, Error **errp)
+{
+    Object *obj;
+    QCryptoTLSCreds *creds;
+    g_autofree char *dir = NULL;
+    g_autofree char *cert_path = NULL;
+    g_autofree char *key_path = NULL;
+    g_autofree char *cert = NULL;
+    g_autofree char *key = NULL;
+    g_autoptr(GError) gerr = NULL;
+    char *vds_err = NULL;
+
+    obj = object_resolve_path_component(object_get_objects_root(), id);
+    if (!obj || !object_dynamic_cast(obj, TYPE_QCRYPTO_TLS_CREDS_X509)) {
+        error_setg(errp, "rdp: no tls-creds-x509 object with id '%s'", id);
+        return false;
+    }
+    creds = QCRYPTO_TLS_CREDS(obj);
+    if (!qcrypto_tls_creds_check_endpoint(creds,
+                                          QCRYPTO_TLS_CREDS_ENDPOINT_SERVER,
+                                          errp)) {
+        return false;
+    }
+    dir = object_property_get_str(obj, "dir", errp);
+    if (!dir) {
+        return false;
+    }
+    cert_path = g_build_filename(dir, QCRYPTO_TLS_CREDS_X509_SERVER_CERT, NULL);
+    key_path = g_build_filename(dir, QCRYPTO_TLS_CREDS_X509_SERVER_KEY, NULL);
+    if (!g_file_get_contents(cert_path, &cert, NULL, &gerr) ||
+        !g_file_get_contents(key_path, &key, NULL, &gerr)) {
+        error_setg(errp, "rdp: cannot read TLS credentials: %s",
+                   gerr->message);
+        return false;
+    }
+    if (vds_server_set_tls(rdp.server, cert, key, &vds_err) != VDS_OK) {
+        rdp_error_take(errp, vds_err, "invalid TLS credentials");
+        return false;
+    }
+    return true;
+}
+
+static void rdp_exit_notify(Notifier *n, void *data)
+{
+    /*
+     * Exit notifiers are run from an atexit() handler.  glibc destroys
+     * thread-local storage before running atexit handlers, and libvds is
+     * Rust: waking a tokio task or emitting a tracing event from here
+     * panics with "cannot access a Thread Local Storage value during or
+     * after destruction", which aborts the process.
+     *
+     * The process is exiting either way, so do not call back into libvds.
+     * Leaking the server and the display heads is harmless: the OS reclaims
+     * them (and stops the RDP thread) at exit.
+     */
+    rdp.server = NULL;
+}
+
+void qemu_rdp_init(Error **errp)
+{
+    ERRP_GUARD();
+    QemuOpts *opts = qemu_opts_find(qemu_find_opts("rdp"), NULL);
+    VdsConfig cfg;
+    VdsLogConfig log_cfg = { .struct_size = sizeof(VdsLogConfig) };
+    const char *str;
+    char *vds_err = NULL;
+    uint32_t version = vds_abi_version();
+    uint64_t port;
+
+    if (!opts) {
+        return;
+    }
+    /* Signed comparison: VDS_ABI_MINOR may be 0. */
+    if ((version >> 16) != VDS_ABI_MAJOR ||
+        (int)(version & 0xffff) < (int)VDS_ABI_MINOR) {
+        error_setg(errp, "rdp: libvds ABI %u.%u is incompatible with %u.%u",
+                   version >> 16, version & 0xffff,
+                   VDS_ABI_MAJOR, VDS_ABI_MINOR);
+        return;
+    }
+
+    log_cfg.filter = qemu_opt_get(opts, "log");
+    str = qemu_opt_get(opts, "log-format");
+    if (!str) {
+        log_cfg.format = VDS_LOG_FORMAT_DEFAULT;
+    } else if (!strcmp(str, "text")) {
+        log_cfg.format = VDS_LOG_FORMAT_TEXT;
+    } else if (!strcmp(str, "json")) {
+        log_cfg.format = VDS_LOG_FORMAT_JSON;
+    } else {
+        error_setg(errp, "rdp: log-format must be 'text' or 'json'");
+        return;
+    }
+    if (vds_log_init(&log_cfg, &vds_err) != VDS_OK) {
+        rdp_error_take(errp, vds_err, "cannot initialize logging");
+        return;
+    }
+
+    vds_config_init(&cfg);
+    if (!rdp_parse_auth(qemu_opt_get(opts, "auth"), &cfg.auth, errp)) {
+        return;
+    }
+    str = qemu_opt_get(opts, "codecs");
+    if (str && !rdp_parse_codecs(str, &cfg.codecs, errp)) {
+        return;
+    }
+    cfg.max_fps = qemu_opt_get_number(opts, "max-fps", cfg.max_fps);
+    cfg.bitrate_kbps = qemu_opt_get_number(opts, "bitrate", 0);
+    cfg.encoder_threads = qemu_opt_get_number(opts, "encoder-threads", 0);
+    cfg.encoder = qemu_opt_get(opts, "encoder");
+    cfg.render_node = qemu_opt_get(opts, "rendernode");
+    cfg.qp_max = qemu_opt_get_number(opts, "qp-max", cfg.qp_max);
+    cfg.refine_qp = qemu_opt_get_number(opts, "refine-qp", cfg.refine_qp);
+    cfg.refine_delay_ms = qemu_opt_get_number(opts, "refine-delay",
+                                              cfg.refine_delay_ms);
+    cfg.egfx_mixed = qemu_opt_get_bool(opts, "egfx-mixed", cfg.egfx_mixed);
+    cfg.audio = qemu_opt_get_bool(opts, "audio", true);
+    cfg.clipboard = qemu_opt_get_bool(opts, "clipboard", true);
+    cfg.resize_on_connect = qemu_opt_get_bool(opts, "resize-on-connect",
+                                              true);
+    if (!rdp_parse_sas(qemu_opt_get(opts, "sas-hotkey"), &cfg.sas_hotkey,
+                       errp)) {
+        return;
+    }
+    cfg.vm_name = qemu_name;
+    rdp.debug_dir = rdp_debug_dir(qemu_opt_get(opts, "debug-dir"));
+    cfg.debug_dir = rdp.debug_dir;
+    cfg.debug_flags = rdp_debug_flags(opts);
+    rdp.debug_flags = cfg.debug_flags;
+    rdp.max_fps = cfg.max_fps;
+
+    rdp.dispatch_bh = qemu_bh_new(rdp_dispatch_bh, NULL);
+    rdp.server = vds_server_new(&cfg, &rdp_callbacks, NULL, &vds_err);
+    if (!rdp.server) {
+        rdp_error_take(errp, vds_err, "invalid configuration");
+        return;
+    }
+
+    str = qemu_opt_get(opts, "tls-creds");
+    if (str && !rdp_load_tls_creds(str, errp)) {
+        return;
+    }
+
+    rdp.username = g_strdup(qemu_opt_get(opts, "username") ?: "");
+    str = qemu_opt_get(opts, "password-secret");
+    if (str) {
+        g_autofree char *password = qcrypto_secret_lookup_as_utf8(str, errp);
+
+        if (!password) {
+            return;
+        }
+        if (vds_set_password(rdp.server, rdp.username, password, NULL,
+                             VDS_CONNECTED_KEEP, false, &vds_err) != VDS_OK) {
+            rdp_error_take(errp, vds_err, "cannot set the password");
+            return;
+        }
+    } else if (cfg.auth != VDS_AUTH_NONE) {
+        warn_report("rdp: no password-secret, clients are refused until "
+                    "set_password is used");
+    }
+
+    rdp_input_init();
+    rdp_display_init(rdp.server, errp);
+    if (*errp) {
+        return;
+    }
+    if (cfg.clipboard) {
+        rdp_clipboard_init(rdp.server);
+    }
+
+    rdp.exit_notifier.notify = rdp_exit_notify;
+    qemu_add_exit_notifier(&rdp.exit_notifier);
+
+    port = qemu_opt_get_number(opts, "port", 0);
+    if (qemu_opt_get(opts, "port")) {
+        uint16_t bound = 0;
+
+        if (port > 65535) {
+            error_setg(errp, "rdp: invalid port %" PRIu64, port);
+            return;
+        }
+        rdp.host = g_strdup(qemu_opt_get(opts, "addr") ?: "127.0.0.1");
+        if (vds_server_listen(rdp.server, rdp.host, port, &bound,
+                              &vds_err) != VDS_OK) {
+            rdp_error_take(errp, vds_err, "cannot listen");
+            return;
+        }
+        rdp.port = bound;
+        trace_rdp_listen(rdp.host, bound);
+    }
+}
+
+void qemu_rdp_set_password(const char *password, SetPasswordAction connected,
+                           SetPasswordOptionsRdp *opts, Error **errp)
+{
+    char *vds_err = NULL;
+    uint32_t action;
+
+    if (!rdp.server) {
+        error_setg(errp, "rdp: RDP is not enabled");
+        return;
+    }
+    switch (connected) {
+    case SET_PASSWORD_ACTION_FAIL:
+        action = VDS_CONNECTED_FAIL;
+        break;
+    case SET_PASSWORD_ACTION_DISCONNECT:
+        action = VDS_CONNECTED_DISCONNECT;
+        break;
+    default:
+        action = VDS_CONNECTED_KEEP;
+        break;
+    }
+    if (vds_set_password(rdp.server,
+                         opts->username ? opts->username : rdp.username,
+                         password, opts->domain, action,
+                         opts->has_one_time && opts->one_time,
+                         &vds_err) != VDS_OK) {
+        rdp_error_take(errp, vds_err, "could not set password");
+    }
+}
+
+void qmp_rdp_set_debug(bool has_input, bool input, bool has_video, bool video,
+                       bool has_pdu, bool pdu, Error **errp)
+{
+    uint32_t flags;
+    char *vds_err = NULL;
+
+    if (!rdp.server) {
+        error_setg(errp, "rdp: RDP is not enabled");
+        return;
+    }
+    if (!rdp.debug_dir) {
+        error_setg(errp, "rdp: no debug directory, start QEMU with "
+                   "-rdp debug-dir=DIR");
+        return;
+    }
+    flags = rdp.debug_flags;
+    if (has_input) {
+        flags = input ? flags | VDS_DEBUG_INPUT : flags & ~VDS_DEBUG_INPUT;
+    }
+    if (has_video) {
+        flags = video ? flags | VDS_DEBUG_VIDEO : flags & ~VDS_DEBUG_VIDEO;
+    }
+    if (has_pdu) {
+        flags = pdu ? flags | VDS_DEBUG_PDU : flags & ~VDS_DEBUG_PDU;
+    }
+    if (vds_server_set_debug(rdp.server, flags, &vds_err) != VDS_OK) {
+        rdp_error_take(errp, vds_err, "cannot change the debug flags");
+        return;
+    }
+    rdp.debug_flags = flags;
+}
+
+void qemu_rdp_set_password_expiry(time_t when, Error **errp)
+{
+    int64_t at = when == TIME_MAX ? VDS_EXPIRE_NEVER : (int64_t)when;
+
+    if (!rdp.server) {
+        error_setg(errp, "rdp: RDP is not enabled");
+        return;
+    }
+    if (vds_set_password_expiry(rdp.server, at) != VDS_OK) {
+        error_setg(errp, "rdp: could not set password expire time");
+    }
+}
+
+static RdpClientInfoList *rdp_client_list(void)
+{
+    RdpClientInfoList *list = NULL;
+    VdsClientInfo info[16];
+    uint32_t n, i;
+
+    n = vds_server_clients(rdp.server, info, ARRAY_SIZE(info));
+    n = MIN(n, ARRAY_SIZE(info));
+    for (i = 0; i < n; i++) {
+        RdpClientInfo *c = g_new0(RdpClientInfo, 1);
+
+        c->sid = info[i].sid;
+        c->peer = g_strdup(info[i].peer);
+        c->user = info[i].user[0] ? g_strdup(info[i].user) : NULL;
+        c->codec = info[i].codec[0] ? g_strdup(info[i].codec) : NULL;
+        c->connected_at = info[i].connected_at;
+        c->fps = info[i].fps;
+        c->bitrate_kbps = info[i].bitrate_kbps;
+        c->has_rtt_ms = info[i].rtt_ms != VDS_RTT_UNKNOWN;
+        c->rtt_ms = info[i].rtt_ms;
+        QAPI_LIST_PREPEND(list, c);
+    }
+    return list;
+}
+
+RdpInfo *qmp_query_rdp(Error **errp)
+{
+    RdpInfo *info = g_new0(RdpInfo, 1);
+
+    info->enabled = rdp.server != NULL;
+    if (!rdp.server) {
+        return info;
+    }
+    if (rdp.host) {
+        info->host = g_strdup(rdp.host);
+        info->has_port = true;
+        info->port = rdp.port;
+    }
+    info->auth = g_strdup(rdp.auth);
+    info->clients = rdp_client_list();
+    if (rdp.debug_dir) {
+        /* A string member has no has_ companion: NULL means "absent". */
+        info->debug_dir = g_strdup(rdp.debug_dir);
+        info->has_debug_input = true;
+        info->debug_input = (rdp.debug_flags & VDS_DEBUG_INPUT) != 0;
+        info->has_debug_video = true;
+        info->debug_video = (rdp.debug_flags & VDS_DEBUG_VIDEO) != 0;
+    }
+    return info;
+}
+
+void hmp_info_rdp(Monitor *mon, const QDict *qdict)
+{
+    g_autoptr(RdpInfo) info = qmp_query_rdp(NULL);
+    RdpClientInfoList *c;
+
+    if (!info->enabled) {
+        monitor_printf(mon, "Server: disabled\n");
+        return;
+    }
+    if (info->host) {
+        monitor_printf(mon, "Server: %s:%" PRId64 " (auth %s)\n",
+                       info->host, info->port, info->auth);
+    } else {
+        monitor_printf(mon, "Server: not listening (auth %s)\n", info->auth);
+    }
+    if (rdp.debug_dir) {
+        monitor_printf(mon, "Debug: %s (input=%s video=%s)\n", rdp.debug_dir,
+                       rdp.debug_flags & VDS_DEBUG_INPUT ? "on" : "off",
+                       rdp.debug_flags & VDS_DEBUG_VIDEO ? "on" : "off");
+    }
+    if (!info->clients) {
+        monitor_printf(mon, "Clients: none\n");
+    }
+    for (c = info->clients; c; c = c->next) {
+        monitor_printf(mon, "Client %" PRId64 ": %s user=%s codec=%s "
+                       "fps=%" PRId64 " bitrate=%" PRId64 "kbit/s",
+                       c->value->sid, c->value->peer,
+                       c->value->user ?: "-", c->value->codec ?: "-",
+                       c->value->fps, c->value->bitrate_kbps);
+        if (c->value->has_rtt_ms) {
+            monitor_printf(mon, " rtt=%" PRId64 "ms", c->value->rtt_ms);
+        }
+        monitor_printf(mon, "\n");
+    }
+}
+
+bool qmp_add_client_rdp(int fd, bool has_skipauth, bool skipauth,
+                        bool has_tls, bool tls, Error **errp)
+{
+    intptr_t sock;
+
+    if (!rdp.server) {
+        error_setg(errp, "rdp: RDP is not enabled");
+        return false;
+    }
+#ifdef _WIN32
+    sock = (intptr_t)_get_osfhandle(fd);
+#else
+    sock = fd;
+#endif
+    if (vds_server_add_client(rdp.server, sock,
+                              has_skipauth && skipauth) != VDS_OK) {
+        error_setg(errp, "rdp: failed to add client");
+        return false;
+    }
+#ifdef _WIN32
+    /* libvds owns the SOCKET now: release the CRT descriptor only. */
+    qemu_close_socket_osfhandle(fd);
+#endif
+    return true;
+}
diff --git a/ui/rdp-display.c b/ui/rdp-display.c
new file mode 100644
index 0000000..6e976e5
--- /dev/null
+++ b/ui/rdp-display.c
@@ -0,0 +1,367 @@
+/*
+ * QEMU RDP server (libvds frontend): display
+ *
+ * One 2D DisplayChangeListener per graphic console. Damage reported by
+ * dpy_gfx_update is accumulated and handed to libvds in dpy_refresh.
+ *
+ * A surface in shareable memory (virtio-gpu resources) is attached to libvds,
+ * which reads it in place from its encoder thread: the main thread only
+ * reports damage. Any other surface is copied by vds_head_submit, which
+ * returns once the damaged rectangles are copied (decision D-004: libvds
+ * never touches the GPU). GL consoles (virgl, vfio display) are supported
+ * through "-display egl-headless", which reads GL frames back into the 2D
+ * surface.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "qemu/thread.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "ui/console.h"
+#include "ui/qemu-pixman.h"
+#include "ui/surface.h"
+#include "rdp.h"
+#include "trace.h"
+
+/* Damage rectangles kept before collapsing to a bounding box. */
+#define RDP_MAX_RECTS 32
+/* Refresh interval while no client consumes frames. */
+#define RDP_IDLE_INTERVAL_MS 100
+
+typedef struct RdpDisplay {
+    DisplayChangeListener dcl;
+    VdsServer *server;
+    VdsHead *head;
+    uint32_t index;
+    DisplaySurface *surface;
+    /* x8r8g8b8 copy, only when the surface uses another format. */
+    pixman_image_t *shadow;
+    /* libvds reads the surface in place (vds_head_attach_shared). */
+    bool shared;
+    VdsRect rects[RDP_MAX_RECTS];
+    uint32_t nrects;
+} RdpDisplay;
+
+static GPtrArray *rdp_displays;
+
+/*
+ * Surface images libvds gave back. libvds releases them from its own threads,
+ * but pixman reference counts are not atomic: the unref happens here, in a
+ * bottom half on the main thread.
+ */
+static struct {
+    QemuMutex lock;
+    GSList *images;
+    QEMUBH *bh;
+} rdp_release;
+
+static void rdp_release_bh(void *opaque)
+{
+    GSList *images, *l;
+
+    qemu_mutex_lock(&rdp_release.lock);
+    images = rdp_release.images;
+    rdp_release.images = NULL;
+    qemu_mutex_unlock(&rdp_release.lock);
+    for (l = images; l; l = l->next) {
+        pixman_image_unref(l->data);
+    }
+    g_slist_free(images);
+}
+
+/* VdsReleaseFn: any thread. */
+static void rdp_release_image(void *opaque)
+{
+    qemu_mutex_lock(&rdp_release.lock);
+    rdp_release.images = g_slist_prepend(rdp_release.images, opaque);
+    qemu_mutex_unlock(&rdp_release.lock);
+    qemu_bh_schedule(rdp_release.bh);
+}
+
+static bool rdp_rect_contains(const VdsRect *r, int x, int y, int w, int h)
+{
+    return x >= (int)r->x && y >= (int)r->y &&
+           x + w <= (int)(r->x + r->w) && y + h <= (int)(r->y + r->h);
+}
+
+static void rdp_damage_add(RdpDisplay *rd, int x, int y, int w, int h)
+{
+    VdsRect *r;
+    uint32_t i;
+    int x1, y1;
+
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    /*
+     * A surface switch damages everything and the flush that follows it
+     * reports the same area again: do not hand libvds the same pixels twice.
+     */
+    for (i = 0; i < rd->nrects; i++) {
+        if (rdp_rect_contains(&rd->rects[i], x, y, w, h)) {
+            return;
+        }
+    }
+    if (rd->nrects == RDP_MAX_RECTS) {
+        /* Collapse everything into the first rectangle. */
+        r = &rd->rects[0];
+        x1 = MAX(r->x + r->w, (uint32_t)(x + w));
+        y1 = MAX(r->y + r->h, (uint32_t)(y + h));
+        for (i = 1; i < rd->nrects; i++) {
+            x1 = MAX((uint32_t)x1, rd->rects[i].x + rd->rects[i].w);
+            y1 = MAX((uint32_t)y1, rd->rects[i].y + rd->rects[i].h);
+            r->x = MIN(r->x, rd->rects[i].x);
+            r->y = MIN(r->y, rd->rects[i].y);
+        }
+        r->x = MIN(r->x, (uint32_t)x);
+        r->y = MIN(r->y, (uint32_t)y);
+        r->w = x1 - r->x;
+        r->h = y1 - r->y;
+        rd->nrects = 1;
+        return;
+    }
+    rd->rects[rd->nrects++] = (VdsRect) { x, y, w, h };
+}
+
+static void rdp_damage_full(RdpDisplay *rd)
+{
+    rd->nrects = 0;
+    if (rd->surface) {
+        rdp_damage_add(rd, 0, 0, surface_width(rd->surface),
+                       surface_height(rd->surface));
+    }
+}
+
+static bool rdp_format_native(pixman_format_code_t format)
+{
+    return format == PIXMAN_x8r8g8b8 || format == PIXMAN_a8r8g8b8;
+}
+
+static void rdp_gfx_update(DisplayChangeListener *dcl,
+                           int x, int y, int w, int h)
+{
+    RdpDisplay *rd = container_of(dcl, RdpDisplay, dcl);
+
+    rdp_damage_add(rd, x, y, w, h);
+}
+
+static void rdp_gfx_switch(DisplayChangeListener *dcl,
+                           DisplaySurface *new_surface)
+{
+    RdpDisplay *rd = container_of(dcl, RdpDisplay, dcl);
+    int w, h;
+
+    rd->surface = new_surface;
+    qemu_pixman_image_unref(rd->shadow);
+    rd->shadow = NULL;
+    if (!new_surface) {
+        return;
+    }
+    w = surface_width(new_surface);
+    h = surface_height(new_surface);
+    if (!rdp_format_native(surface_format(new_surface))) {
+        rd->shadow = pixman_image_create_bits(PIXMAN_x8r8g8b8, w, h, NULL, 0);
+    }
+    if (vds_head_resize(rd->head, w, h) != VDS_OK) {
+        warn_report("rdp: cannot use a %dx%d display", w, h);
+    }
+    rd->shared = false;
+    if (!rd->shadow && new_surface->share_handle != SHAREABLE_NONE) {
+        /* The reference keeps the memory mapped until libvds lets it go. */
+        pixman_image_t *image = pixman_image_ref(new_surface->image);
+        const uint8_t *data = (const uint8_t *)pixman_image_get_data(image);
+        int stride = pixman_image_get_stride(image);
+
+        if (vds_head_attach_shared(rd->head, data, (size_t)stride * h, stride,
+                                   rdp_release_image, image) == VDS_OK) {
+            rd->shared = true;
+        } else {
+            pixman_image_unref(image);
+        }
+    }
+    trace_rdp_display_switch(rd->index, w, h, surface_format(new_surface),
+                             rd->shared);
+    rdp_damage_full(rd);
+}
+
+static void rdp_refresh(DisplayChangeListener *dcl)
+{
+    RdpDisplay *rd = container_of(dcl, RdpDisplay, dcl);
+    bool wanted = vds_server_wants_frame(rd->server);
+    bool active = qemu_rdp_has_client();
+    uint64_t interval = active ? 1000 / MAX(qemu_rdp_max_fps(), 1)
+                               : RDP_IDLE_INTERVAL_MS;
+    int64_t started = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
+    pixman_image_t *src;
+    uint32_t i;
+
+    trace_rdp_display_refresh(rd->index, active, wanted, interval);
+    qemu_console_listener_set_refresh(dcl, interval);
+    qemu_console_hw_update(dcl->con);
+    if (!wanted || !rd->surface || !rd->nrects) {
+        return;
+    }
+
+    if (rd->shared) {
+        /* libvds reads the surface itself, from its encoder thread. */
+        vds_head_damage(rd->head, rd->rects, rd->nrects);
+    } else {
+        src = rd->surface->image;
+        if (rd->shadow) {
+            for (i = 0; i < rd->nrects; i++) {
+                pixman_image_composite(PIXMAN_OP_SRC, src, NULL, rd->shadow,
+                                       rd->rects[i].x, rd->rects[i].y, 0, 0,
+                                       rd->rects[i].x, rd->rects[i].y,
+                                       rd->rects[i].w, rd->rects[i].h);
+            }
+            src = rd->shadow;
+        }
+        vds_head_submit(rd->head, (const uint8_t *)pixman_image_get_data(src),
+                        (size_t)pixman_image_get_stride(src) *
+                        pixman_image_get_height(src),
+                        pixman_image_get_stride(src), rd->rects, rd->nrects);
+    }
+    /*
+     * T-V2: how long this refresh cost QEMU, everything before libvds sees the
+     * damage: the dirty-page scan in qemu_console_hw_update, the shadow copy and the
+     * submit (or only the damage report for a shared surface). libvds times
+     * the rest of the path (docs/spec/logging.md 5).
+     */
+    trace_rdp_display_submit(rd->index, rd->nrects,
+                             qemu_clock_get_us(QEMU_CLOCK_REALTIME) - started);
+    rd->nrects = 0;
+}
+
+static bool rdp_check_format(DisplayChangeListener *dcl,
+                             pixman_format_code_t format)
+{
+    /* Other formats work through the shadow image, but cost a copy. */
+    return rdp_format_native(format);
+}
+
+static void rdp_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
+{
+    RdpDisplay *rd = container_of(dcl, RdpDisplay, dcl);
+
+    vds_cursor_set_visible(rd->server, on);
+}
+
+static void rdp_cursor_define(DisplayChangeListener *dcl, QEMUCursor *c)
+{
+    RdpDisplay *rd = container_of(dcl, RdpDisplay, dcl);
+
+    if (vds_cursor_define(rd->server, c->width, c->height,
+                          MAX(c->hot_x, 0), MAX(c->hot_y, 0),
+                          c->data) != VDS_OK) {
+        trace_rdp_display_cursor_rejected(c->width, c->height);
+    }
+}
+
+static const DisplayChangeListenerOps rdp_dcl_ops = {
+    .dpy_name = "rdp",
+    .dpy_refresh = rdp_refresh,
+    .dpy_gfx_update = rdp_gfx_update,
+    .dpy_gfx_switch = rdp_gfx_switch,
+    .dpy_gfx_check_format = rdp_check_format,
+    .dpy_mouse_set = rdp_mouse_set,
+    .dpy_cursor_define = rdp_cursor_define,
+};
+
+void rdp_display_init(VdsServer *server, Error **errp)
+{
+    QemuConsole *con;
+    uint32_t i;
+
+    qemu_mutex_init(&rdp_release.lock);
+    rdp_release.bh = qemu_bh_new(rdp_release_bh, NULL);
+    rdp_displays = g_ptr_array_new();
+    for (i = 0; (con = qemu_console_lookup_by_index(i)); i++) {
+        RdpDisplay *rd;
+        char *vds_err = NULL;
+
+        if (!qemu_console_is_graphic(con)) {
+            continue;
+        }
+        rd = g_new0(RdpDisplay, 1);
+        rd->server = server;
+        rd->index = qemu_console_get_index(con);
+        rd->head = vds_head_add(server, rd->index,
+                                qemu_console_get_width(con, 640),
+                                qemu_console_get_height(con, 480), &vds_err);
+        if (!rd->head) {
+            error_setg(errp, "rdp: cannot add display %u: %s", rd->index,
+                       vds_err ? vds_err : "unknown error");
+            vds_free_string(vds_err);
+            g_free(rd);
+            return;
+        }
+        g_ptr_array_add(rdp_displays, rd);
+        qemu_console_register_listener(con, &rd->dcl, &rdp_dcl_ops);
+    }
+    if (!rdp_displays->len) {
+        warn_report("rdp: the machine has no graphic console");
+    }
+}
+
+void rdp_display_fini(void)
+{
+    uint32_t i;
+
+    if (!rdp_displays) {
+        return;
+    }
+    for (i = 0; i < rdp_displays->len; i++) {
+        RdpDisplay *rd = g_ptr_array_index(rdp_displays, i);
+
+        qemu_console_unregister_listener(&rd->dcl);
+        vds_head_remove(rd->head);
+        qemu_pixman_image_unref(rd->shadow);
+        g_free(rd);
+    }
+    g_ptr_array_free(rdp_displays, true);
+    rdp_displays = NULL;
+}
+
+QemuConsole *rdp_display_console(uint32_t head)
+{
+    uint32_t i;
+
+    for (i = 0; rdp_displays && i < rdp_displays->len; i++) {
+        RdpDisplay *rd = g_ptr_array_index(rdp_displays, i);
+
+        if (rd->index == head) {
+            return rd->dcl.con;
+        }
+    }
+    return NULL;
+}
+
+void rdp_display_layout(const VdsMonitor *monitors, uint32_t count)
+{
+    uint32_t i;
+
+    /* Monitor i of the client drives graphic console i of the guest. */
+    for (i = 0; rdp_displays && i < count && i < rdp_displays->len; i++) {
+        RdpDisplay *rd = g_ptr_array_index(rdp_displays, i);
+        QemuConsole *con = rd->dcl.con;
+        QemuUIInfo info;
+
+        if (!qemu_console_ui_info_supported(con)) {
+            trace_rdp_display_layout_unsupported(rd->index);
+            continue;
+        }
+        info = *qemu_console_get_ui_info(con);
+        info.xoff = monitors[i].left;
+        info.yoff = monitors[i].top;
+        info.width = monitors[i].width;
+        info.height = monitors[i].height;
+        info.width_mm = monitors[i].width_mm;
+        info.height_mm = monitors[i].height_mm;
+        trace_rdp_display_layout(rd->index, info.width, info.height);
+        qemu_console_set_ui_info(con, &info, false);
+    }
+}
diff --git a/ui/rdp-input.c b/ui/rdp-input.c
new file mode 100644
index 0000000..9acddcc
--- /dev/null
+++ b/ui/rdp-input.c
@@ -0,0 +1,127 @@
+/*
+ * QEMU RDP server (libvds frontend): keyboard and mouse
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "rdp.h"
+#include "trace.h"
+
+/* XT scancodes of the lock keys */
+#define RDP_SC_CAPS_LOCK   0x3a
+#define RDP_SC_NUM_LOCK    0x45
+#define RDP_SC_SCROLL_LOCK 0x46
+
+/* Wheel notches injected for one client event at most. */
+#define RDP_WHEEL_MAX_CLICKS 16
+
+static struct {
+    int last_x;
+    int last_y;
+    bool have_last;
+} rdp_input;
+
+void rdp_input_init(void)
+{
+}
+
+void rdp_input_key(uint8_t scancode, bool extended, bool down)
+{
+    /* QEMU numeric keycodes: E0-prefixed keys have bit 7 set. */
+    int qnum = (scancode & 0x7f) | (extended ? 0x80 : 0);
+
+    qemu_input_event_send_key_number(NULL, qnum, down);
+}
+
+static void rdp_toggle(int scancode)
+{
+    qemu_input_event_send_key_number(NULL, scancode, true);
+    qemu_input_event_send_key_number(NULL, scancode, false);
+}
+
+void rdp_input_lock_sync(bool scroll, bool num, bool caps)
+{
+    int leds = qemu_input_get_leds_mask(NULL);
+
+    trace_rdp_input_lock_sync(scroll, num, caps, leds);
+    if (caps != !!(leds & QEMU_CAPS_LOCK_LED)) {
+        rdp_toggle(RDP_SC_CAPS_LOCK);
+    }
+    if (num != !!(leds & QEMU_NUM_LOCK_LED)) {
+        rdp_toggle(RDP_SC_NUM_LOCK);
+    }
+    if (scroll != !!(leds & QEMU_SCROLL_LOCK_LED)) {
+        rdp_toggle(RDP_SC_SCROLL_LOCK);
+    }
+}
+
+void rdp_input_pointer_abs(uint32_t head, uint32_t x, uint32_t y,
+                           uint32_t width, uint32_t height)
+{
+    QemuConsole *con = rdp_display_console(head);
+
+    if (!con) {
+        return;
+    }
+    if (qemu_input_is_absolute(con)) {
+        qemu_input_queue_abs(con, INPUT_AXIS_X, x, 0, width);
+        qemu_input_queue_abs(con, INPUT_AXIS_Y, y, 0, height);
+    } else if (rdp_input.have_last) {
+        /* Relative-only guest pointer: send deltas. */
+        qemu_input_queue_rel(con, INPUT_AXIS_X, (int)x - rdp_input.last_x);
+        qemu_input_queue_rel(con, INPUT_AXIS_Y, (int)y - rdp_input.last_y);
+    }
+    rdp_input.last_x = x;
+    rdp_input.last_y = y;
+    rdp_input.have_last = true;
+    qemu_input_event_sync();
+}
+
+void rdp_input_pointer_rel(int32_t dx, int32_t dy)
+{
+    qemu_input_queue_rel(NULL, INPUT_AXIS_X, dx);
+    qemu_input_queue_rel(NULL, INPUT_AXIS_Y, dy);
+    qemu_input_event_sync();
+}
+
+void rdp_input_button(uint32_t button, bool down)
+{
+    static const InputButton map[] = {
+        [VDS_BUTTON_LEFT] = INPUT_BUTTON_LEFT,
+        [VDS_BUTTON_RIGHT] = INPUT_BUTTON_RIGHT,
+        [VDS_BUTTON_MIDDLE] = INPUT_BUTTON_MIDDLE,
+        [VDS_BUTTON_SIDE] = INPUT_BUTTON_SIDE,
+        [VDS_BUTTON_EXTRA] = INPUT_BUTTON_EXTRA,
+    };
+
+    if (button >= ARRAY_SIZE(map)) {
+        return;
+    }
+    qemu_input_queue_btn(NULL, map[button], down);
+    qemu_input_event_sync();
+}
+
+static void rdp_wheel_clicks(InputButton btn, int count)
+{
+    while (count-- > 0) {
+        qemu_input_queue_btn(NULL, btn, true);
+        qemu_input_event_sync();
+        qemu_input_queue_btn(NULL, btn, false);
+        qemu_input_event_sync();
+    }
+}
+
+void rdp_input_wheel(int32_t dx, int32_t dy)
+{
+    trace_rdp_input_wheel(dx, dy);
+    /* A bogus client value must not stall the main loop clicking. */
+    dx = MAX(MIN(dx, RDP_WHEEL_MAX_CLICKS), -RDP_WHEEL_MAX_CLICKS);
+    dy = MAX(MIN(dy, RDP_WHEEL_MAX_CLICKS), -RDP_WHEEL_MAX_CLICKS);
+    rdp_wheel_clicks(dy > 0 ? INPUT_BUTTON_WHEEL_UP : INPUT_BUTTON_WHEEL_DOWN,
+                     abs(dy));
+    rdp_wheel_clicks(dx > 0 ? INPUT_BUTTON_WHEEL_RIGHT
+                            : INPUT_BUTTON_WHEEL_LEFT, abs(dx));
+}
diff --git a/ui/rdp.h b/ui/rdp.h
new file mode 100644
index 0000000..870b4c3
--- /dev/null
+++ b/ui/rdp.h
@@ -0,0 +1,42 @@
+/*
+ * QEMU RDP server (libvds frontend): internal declarations
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef UI_RDP_H
+#define UI_RDP_H
+
+#include <vds.h>
+
+#include "ui/console.h"
+
+/* rdp-core.c */
+VdsServer *qemu_rdp_server(void);
+uint32_t qemu_rdp_max_fps(void);
+bool qemu_rdp_has_client(void);
+
+/* rdp-display.c */
+void rdp_display_init(VdsServer *server, Error **errp);
+void rdp_display_fini(void);
+QemuConsole *rdp_display_console(uint32_t head);
+void rdp_display_layout(const VdsMonitor *monitors, uint32_t count);
+
+/* rdp-input.c */
+void rdp_input_init(void);
+void rdp_input_key(uint8_t scancode, bool extended, bool down);
+void rdp_input_lock_sync(bool scroll, bool num, bool caps);
+void rdp_input_pointer_abs(uint32_t head, uint32_t x, uint32_t y,
+                           uint32_t width, uint32_t height);
+void rdp_input_pointer_rel(int32_t dx, int32_t dy);
+void rdp_input_button(uint32_t button, bool down);
+void rdp_input_wheel(int32_t dx, int32_t dy);
+
+/* rdp-clipboard.c */
+void rdp_clipboard_init(VdsServer *server);
+void rdp_clipboard_client_grab(const uint32_t *types, uint32_t count);
+void rdp_clipboard_client_release(void);
+void rdp_clipboard_client_request(uint32_t type);
+void rdp_clipboard_client_data(uint32_t type, const uint8_t *data, size_t len);
+
+#endif /* UI_RDP_H */
