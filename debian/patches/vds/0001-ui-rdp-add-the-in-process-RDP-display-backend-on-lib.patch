+static void rdp_cb_layout(void *opaque, const VdsMonitor *monitors,
+                          uint32_t count)
+{
+    rdp_display_layout(monitors, count);
+}
+
+static void rdp_cb_clipboard_grab(void *opaque, const uint32_t *types,
+                                  uint32_t count)
+{
+    rdp_clipboard_client_grab(types, count);
+}
