+static void rdp_cb_wakeup(void *opaque)
+{
+    /* Any thread: only schedule the bottom half. */
+    qemu_bh_schedule(rdp.dispatch_bh);
+}
+
+static void rdp_dispatch_bh(void *opaque)
+{
+    if (rdp.server) {
+        vds_server_dispatch(rdp.server);
+    }
+}
