+/*
+ * Save a whole VMSD field, including its JSON blob separately when @vmdesc
+ * is specified.
+ */
+static int vmstate_save_field_with_vmdesc(QEMUFile *f, void *pv, size_t size,
+                                          const VMStateDescription *vmsd,
+                                          const VMStateField *field,
+                                          JSONWriter *vmdesc, int i, int max,
+                                          Error **errp)
+{
+    uint64_t old_offset, written_bytes;
+    int ret;
+
+    vmsd_desc_field_start(vmsd, vmdesc, field, i, max);
+
+    old_offset = qemu_file_transferred(f);
+    ret = vmstate_save_field(f, pv, size, field, vmdesc, errp);
+    written_bytes = qemu_file_transferred(f) - old_offset;
+
+    vmsd_desc_field_end(vmsd, vmdesc, field, written_bytes);
+
+    if (ret) {
+        error_prepend(errp, "Save of field %s/%s failed: ",
+                      vmsd->name, field->name);
+    }
+
+    return ret;
+}
