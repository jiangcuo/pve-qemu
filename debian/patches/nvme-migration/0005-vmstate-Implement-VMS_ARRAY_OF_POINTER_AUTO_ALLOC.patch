 migration/savevm.c           |  27 +++-
 migration/vmstate-types.c    |  32 ++--
 migration/vmstate.c          | 280 ++++++++++++++++++++++++++---------
 scripts/analyze-migration.py |  22 +--
 5 files changed, 316 insertions(+), 105 deletions(-)

