From: jiangcuo <jiangcuo@lierfang.com>
Subject: [PATCH] hw/intc/arm_gicv3_kvm: fix ICC_CTLR_EL1 migration across heterogeneous hosts

ICC_CTLR_EL1 contains read-only hardware-defined fields (PRIbits,
IDbits, A3V, SEIS) that vary between GIC implementations.  When
migrating between hosts with different GIC implementations (e.g.
Kunpeng to Apple nested KVM), blindly writing the source's full
ICC_CTLR_EL1 value causes KVM_SET_DEVICE_ATTR to fail with EINVAL
because the kernel validates that RO fields match the local hardware.

Fix by reading the destination's ICC_CTLR_EL1 first, then merging:
keep the destination's read-only hardware fields and only copy the
source's software-writable bits (CBPR, EOImode).

Signed-off-by: jiangcuo <jiangcuo@lierfang.com>
---
 hw/intc/arm_gicv3_kvm.c | 34 +++++++++++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/hw/intc/arm_gicv3_kvm.c b/hw/intc/arm_gicv3_kvm.c
--- a/hw/intc/arm_gicv3_kvm.c
+++ b/hw/intc/arm_gicv3_kvm.c
@@ -460,8 +460,38 @@
         int num_pri_bits;
 
         kvm_gicc_access(s, ICC_SRE_EL1, ncpu, &c->icc_sre_el1, true);
-        kvm_gicc_access(s, ICC_CTLR_EL1, ncpu,
-                        &c->icc_ctlr_el1[GICV3_NS], true);
+        /*
+         * ICC_CTLR_EL1 contains RO hardware-defined fields (PRIbits,
+         * IDbits, A3V, SEIS) that may differ between hosts.  Read the
+         * destination's value first, then merge only the software-
+         * writable bits (CBPR, EOImode) from the migrated state.
+         */
+        {
+            uint64_t src_ctlr = c->icc_ctlr_el1[GICV3_NS];
+            uint64_t dest_ctlr;
+            uint64_t merged;
+            kvm_gicc_access(s, ICC_CTLR_EL1, ncpu, &dest_ctlr, false);
+            merged = (dest_ctlr & ~(ICC_CTLR_EL1_CBPR | ICC_CTLR_EL1_EOIMODE))
+                   | (src_ctlr & (ICC_CTLR_EL1_CBPR | ICC_CTLR_EL1_EOIMODE));
+            if (src_ctlr != merged) {
+                warn_report("GICv3 CPU%d ICC_CTLR_EL1 migration fixup: "
+                            "src=0x%"PRIx64" (PRIbits=%d IDbits=%d) "
+                            "dest=0x%"PRIx64" (PRIbits=%d IDbits=%d) "
+                            "merged=0x%"PRIx64,
+                            ncpu, src_ctlr,
+                            (int)((src_ctlr & ICC_CTLR_EL1_PRIBITS_MASK)
+                                  >> ICC_CTLR_EL1_PRIBITS_SHIFT) + 1,
+                            (int)((src_ctlr >> ICC_CTLR_EL1_IDBITS_SHIFT) & 7),
+                            dest_ctlr,
+                            (int)((dest_ctlr & ICC_CTLR_EL1_PRIBITS_MASK)
+                                  >> ICC_CTLR_EL1_PRIBITS_SHIFT) + 1,
+                            (int)((dest_ctlr >> ICC_CTLR_EL1_IDBITS_SHIFT) & 7),
+                            merged);
+            }
+            kvm_gicc_access(s, ICC_CTLR_EL1, ncpu, &merged, true);
+            /* Update so num_pri_bits below uses destination's PRIbits */
+            c->icc_ctlr_el1[GICV3_NS] = merged;
+        }
         kvm_gicc_access(s, ICC_IGRPEN0_EL1, ncpu,
                         &c->icc_igrpen[GICV3_G0], true);
         kvm_gicc_access(s, ICC_IGRPEN1_EL1, ncpu,
