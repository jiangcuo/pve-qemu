diff --git a/hw/tpm/tpm-sysbus.c b/hw/tpm/tpm-sysbus.c
new file mode 100644
index 00000000000..f13a5e238ce
--- /dev/null
+++ b/hw/tpm/tpm-sysbus.c
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Support functions for SysBus TPM devices.
+ */
+#include "qemu/osdep.h"
+
+#include "system/tpm.h"
+#include "hw/platform-bus.h"
+#include "hw/sysbus.h"
+#include "qapi/error.h"
+
+void tpm_sysbus_plug(TPMIf *tpmif, Object *pbus, hwaddr pbus_base)
+{
+    PlatformBusDevice *pbusdev;
+    SysBusDevice *sbdev;
+    MemoryRegion *mr;
+    hwaddr tpm_base;
+
+    if (!object_dynamic_cast(OBJECT(tpmif), TYPE_SYS_BUS_DEVICE)) {
+        return;
+    }
+
+    pbusdev = PLATFORM_BUS_DEVICE(pbus);
+    sbdev = SYS_BUS_DEVICE(tpmif);
+    tpm_base = platform_bus_get_mmio_addr(pbusdev, sbdev, 0);
+    assert(tpm_base != -1);
+    tpm_base += pbus_base;
+
+    mr = sysbus_mmio_get_region(sbdev, 0);
+    object_property_set_uint(OBJECT(sbdev), "x-baseaddr", tpm_base,
+                             &error_abort);
+    object_property_set_uint(OBJECT(sbdev), "x-size", memory_region_size(mr),
+                             &error_abort);
+
+    if (sysbus_has_mmio(sbdev, 1) &&
+        object_property_find(OBJECT(sbdev), "x-ppi-baseaddr")) {
+        hwaddr ppi_base = platform_bus_get_mmio_addr(pbusdev, sbdev, 1);
+
+        assert(ppi_base != -1);
+        object_property_set_uint(OBJECT(sbdev), "x-ppi-baseaddr",
+                                 ppi_base + pbus_base, &error_abort);
+    }
+}
